# App (runtime role, subject to RLS)
DATABASE_URL=postgres://app_user:app_user@localhost:5432/kanban
# Owner role (migrations / seeds / demo reset). Use the DIRECT connection string (Neon: without
# "-pooler"): the demo reset lock is a session advisory lock, which PgBouncer pooling breaks.
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/kanban
# Test databases
TEST_DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/kanban_test
TEST_DATABASE_URL=postgres://app_user:app_user@localhost:5432/kanban_test
PORT=3000
# development | test | production
NODE_ENV=development
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
APP_ORIGIN=http://localhost:5173
# none = in-app mailbox only | smtp = Mailpit locally (docker compose --profile mail up,
# UI http://localhost:8025) | brevo = Brevo HTTPS API (api.brevo.com; Render free blocks SMTP).
MAIL_TRANSPORT=none
# smtp only (Mailpit defaults; user/pass only for an SMTP server that needs a login)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
# brevo only: API key from the Brevo dashboard (SMTP & API > API Keys)
BREVO_API_KEY=
# Sender; with brevo it must be your verified sender, e.g. Kanban demo <you@gmail.com>
MAIL_FROM=Kanban <no-reply@localhost>
DEMO_MODE=false
# Daily reset: also POST /internal/demo/reset with "Authorization: Bearer $DEMO_RESET_TOKEN"
DEMO_RESET_TOKEN=change-me
# Signs the unsubscribe links of emails (HMAC-SHA256). Generate with: openssl rand -hex 32
UNSUBSCRIBE_SECRET=change-me
# Login/register attempts per minute and IP
AUTH_RATE_LIMIT_MAX=5
# Demo logins ("Entrar como …") per minute and IP; its own counter, higher than login
DEMO_LOGIN_RATE_LIMIT_MAX=30
# Built SPA to serve (optional; default apps/web/dist, served only if it exists)
# WEB_DIST_DIR=
# Proxies in front of the API (0 locally, 1 on Render); used for the client IP
TRUST_PROXY_HOPS=0
# true/1: log the client IP the app sees for each /api/health request ("client ip"), to check
# TRUST_PROXY_HOPS after a deploy. Turn it off again afterwards.
LOG_CLIENT_IP=false
# Dev only (read by apps/web/vite.config.ts from the shell, NOT from .env: export it before
# `pnpm --filter @kanban/web dev`). Where the Vite proxy sends /api and /socket.io.
# API_URL=http://localhost:3000

# e2e (pnpm e2e), all optional. The run DROPS and recreates the database below with the owner
# role, so the script refuses names not matching ^kanban_e2e[a-z0-9_]*$ and non-local hosts.
# E2E_PORT=3130
# E2E_DB_NAME=kanban_e2e
# E2E_OWNER_URL=postgres://postgres:postgres@localhost:5432
# E2E_APP_URL=postgres://app_user:app_user@localhost:5432
# E2E_SKIP_BUILD=1   # reuse apps/web/dist
# E2E_REUSE=1        # debug: reuse an already running server
